# Application Port
PORT=3000

# Gmail SMTP Configuration
# Use your full Gmail address and a 16-character Google App Password (not your normal Gmail password)
# Generate one at: https://myaccount.google.com/apppasswords (Requires 2-Step Verification)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Anti-spam delay between outgoing emails (in seconds)
DEFAULT_DELAY_SECONDS=3
